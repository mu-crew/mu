{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",

    // tsup's bundled rollup-plugin-dts injects `baseUrl: "."` into the
    // compiler options it builds for .d.ts generation (rollup.js ~6837).
    // TS 6 deprecates baseUrl and errors on it (TS5101), which fails the
    // dts step even though nothing here sets it. Silencing is safe: we do
    // not use baseUrl or paths, so the injected value resolves nothing.
    // Remove this once tsup ships a plugin that stops injecting it.
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
