#!/usr/bin/env node
// mu-plugin-ssh: an example mu plugin over plain ssh. It provides two seams:
// the host link (exec and fetch) and a `pane` job kind, rung 3 of the placement
// ladder with no hand-written templates. Read it next to
// docs/reference/plugin-protocol.md.
//
//   mu plugin add ssh -- /abs/path/mu-plugin-ssh [ssh command…]
//   mu host add devbox --plugin ssh
//   mu host check devbox
//
// The mu host's name is the ssh destination, so give it a ~/.ssh/config
// alias. Words after the path replace the ssh command (default: `ssh`), e.g.
// `-- /abs/mu-plugin-ssh ssh -o BatchMode=yes -J jump`. The remote login
// shell must be POSIX-like: the plugin sends it `cd <cwd> && exec /bin/sh -c`.
//
//   mu agent spawn w1 --host devbox --worktree      # a pane over ssh
//
// The pane kind has no channel of its own: mu's built-in ctl (pi) , hooks or mux
// carry the agents. job.start only builds the view, an interactive ssh that
// forwards mu's ctl socket (-L) and runs the harness in a remote shell. The
// view's ssh always runs with ControlMaster=no ControlPath=none: a -L through a
// shared control master is bound by the master, so the listener outlives the
// pane and a later ssh asking for the same forward exits 0 with no socket. Our
// options come first (ssh keeps the first value), so the words after the path
// cannot undo them. Each pane keeps its own connection; per-connection
// MaxSessions 1 does not block it, a host with one practical connection does.
//
// Lifetime: the view is bound, so mu kills the view, then asks job.stop. The
// remote side keeps `$HOME/.local/state/mu-plugin-ssh/<handle>/` (or the plugin's
// MU_SSH_STATE_DIR; never the host's XDG_STATE_HOME, which two ssh sessions can disagree
// on): the launch claims
// it with an atomic mkdir and records its pid and start time; job.stop answers
// null only on proof: the script's exit 0 and its receipt line for this handle. Proof is: the launch never claimed (the stop claims it
// first, so it never can), or the recorded leader is gone and its process group
// is empty (members are listed with ps and signalled by pid, HUP, TERM, KILL, while the leader
// matches; the harness runs with job control off so it stays in that group).
// Any doubt (ssh fails, no pid recorded, a process remains) is an error, so mu
// keeps the tree and the job record. Descendants that left the process group
// are not covered by the proof.
//
// See test/_fake-plugin.mjs for the channel and host seams.

import { spawn } from "node:child_process";
import { createHash } from "node:crypto";
import { readFileSync, realpathSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

// The digest of the schema this plugin was written against. mu refuses a
// plugin whose digest is not the published file's; this one reads the copy
// shipped beside it in the mu package.
const SCHEMA = join(
  dirname(realpathSync(fileURLToPath(import.meta.url))),
  "..",
  "..",
  "schemas",
  "plugin-protocol-v1.json",
);
const DIGEST = `sha256:${createHash("sha256").update(readFileSync(SCHEMA)).digest("hex")}`;

const SSH = process.argv.length > 2 ? process.argv.slice(2) : ["ssh"];
/** Each stream is cut here, so a reply stays under the protocol's 1 MiB line limit. */
const MAX_OUTPUT = 256 * 1024;
const SEAMS = {
  job: {
    kind: "pane",
    view: "bound", // the ssh view's death ends the job
    handle: "reply", // the handle is derived from the job key: always known to job.stop
    // job.start only builds a command line (no remote effect), so a repeat of a key is the same
    // reply and job.lookup has nothing to find: none proves nothing started.
    start: { lookup: true, dedupe: { exact: true, windowMs: 24 * 60 * 60 * 1000 }, fenceKey: true },
    honours: { command: true, env: true, sockets: true, roles: ["full-access"] },
  },
  link: {
    fetch: true, // link.fetch brings a remote HEAD home, so a host needs no --fetch
    slots: "mu", // every call is one ssh connection: mu counts them against --max-sessions
    remoteOnTimeout: "unknown", // killing ssh does not prove the remote script stopped
    quiescence: "provable", // mu's own scans see the host's processes
    maxScriptBytes: 128 * 1024,
    checks: ["reach"],
  },
};

const send = (msg) => process.stdout.write(`${JSON.stringify(msg)}\n`);
const reply = (id, result) => send({ jsonrpc: "2.0", id, result });
const fail = (id, kind, message, remedy) =>
  send({ jsonrpc: "2.0", id, error: { code: -32000, message, data: { kind, remedy } } });

/** POSIX single-quoting, for the remote shell and GIT_SSH_COMMAND. */
const q = (s) => `'${String(s).replaceAll("'", `'\\''`)}'`;

// Calls in flight, by request id: their child, so $/cancel and EOF can stop it.
const running = new Map();

/** Run argv locally; answer `{exitCode, stdout, stderr, partial}`, or null exit on timeout. */
function run(id, argv, { timeoutMs, env, cwd, host, then }) {
  const child = spawn(argv[0], argv.slice(1), {
    cwd,
    env: env ?? process.env,
    stdio: ["ignore", "pipe", "pipe"],
  });
  running.set(id, child);
  const out = { stdout: "", stderr: "", partial: false };
  const collect = (key) => (d) => {
    const room = MAX_OUTPUT - out[key].length;
    if (d.length > room) out.partial = true;
    if (room > 0) out[key] += d.toString("utf8", 0, Math.min(d.length, room));
  };
  child.stdout.on("data", collect("stdout"));
  child.stderr.on("data", collect("stderr"));
  let timedOut = false;
  const timer = setTimeout(() => {
    timedOut = true;
    child.kill("SIGKILL");
  }, timeoutMs);
  const done = (exitCode) => {
    clearTimeout(timer);
    if (!running.delete(id)) return; // cancelled: mu ignores any answer now
    // ssh exits 255 on its own errors. An auth failure ran nothing and needs a person.
    if (exitCode === 255 && /Permission denied|Host key verification failed/.test(out.stderr)) {
      fail(id, "human", out.stderr.split("\n")[0], `fix ssh access to ${host}`);
      return;
    }
    const result = { exitCode: timedOut ? null : exitCode, ...out };
    if (then) then(result);
    else reply(id, result);
  };
  child.on("error", (e) => {
    out.stderr = e.message;
    done(127);
  });
  child.on("close", (code) => done(code ?? null));
}

/** ssh to the mu host and run `script` with /bin/sh in `cwd` (`.` is the login directory). */
function exec(id, host, script, cwd, timeoutMs) {
  run(id, [...SSH, host, `cd ${q(cwd)} && exec /bin/sh -c ${q(script)}`], { timeoutMs, host });
}

// ─── The pane job kind ──────────────────────────────────────────────────

/**
 * The host's state directory, one namespace for every call of this plugin process: start and stop
 * run in different ssh sessions, whose XDG_STATE_HOME can differ (a startup file that sets it only
 * on a tty), so it is never read from the host's environment. $HOME is the account's, or the
 * plugin's own MU_SSH_STATE_DIR (an absolute path on the host).
 */
const STATE_DIR = process.env.MU_SSH_STATE_DIR
  ? q(process.env.MU_SSH_STATE_DIR)
  : '"$HOME/.local/state/mu-plugin-ssh"';
const NEED_HOME = process.env.MU_SSH_STATE_DIR ? "true" : '[ -n "$HOME" ] || { echo "no HOME" >&2; exit 5; }';
/** The line a stop prints last when (and only when) it proved the job gone: scoped to its handle. */
const receiptOf = (handle) => `mu-plugin-ssh-receipt ${handle}`;
/** The job's handle: a pure function of mu's job key, so job.stop always has it. */
const handleOf = (key) => `ssh-${createHash("sha256").update(String(key)).digest("hex").slice(0, 32)}`;
const HANDLE = /^ssh-[0-9a-f]{32}$/;
/** The leader's start time, normalised: with its pid, the identity a recycled pid cannot fake. */
const STARTED = String.raw`ps -o lstart= -p "$P" 2>/dev/null | tr -s ' ' | sed 's/^ //;s/ $//'`;

/** What the view's ssh runs on the host: claim the job, record the leader, run the harness. */
function launchScript(handle, cwd, env, cmd) {
  const envWords = Object.entries(env).map(([k, v]) => `${k}=${q(v)}`);
  return [
    `${NEED_HOME}; D=${STATE_DIR}; H=${handle}`,
    // The atomic claim: a stop that got here first wins, and then nothing ever runs.
    `mkdir -p "$D" && mkdir "$D/$H" 2>/dev/null || { echo "mu-plugin-ssh: job $H is stopped or already started" >&2; exit 1; }`,
    `P=$$; printf '%s %s\\n' "$P" "$(${STARTED})" > "$D/$H/pid.tmp" && mv "$D/$H/pid.tmp" "$D/$H/pid"`,
    `cd ${q(cwd)} && exec env ${envWords.join(" ")} "\${SHELL:-/bin/sh}" -ilc ${q(`set +m; ${cmd}`)}`,
  ].join("\n");
}

/** The shell prelude of a stop or status: read the recorded leader. */
// Job control is off for the harness (set +m above): under a tty an interactive shell would put
// each foreground command in its own process group, out of the one this script checks.
// Group members are listed with ps and signalled by pid: dash's kill rejects `-- -PGID`, and a
// failed probe must never read as an empty group.
const READ_STATE = `${NEED_HOME}; D=${STATE_DIR}; H=%H
# A zombie leader is dead: it is only waiting for its parent to reap it.
leader() { P=$1; [ "$(${STARTED})" = "$2" ] && case "$(ps -o stat= -p "$P" 2>/dev/null)" in Z*) false ;; *) true ;; esac; }
members() { t=$(ps -A -o pid= -o pgid= -o stat= 2>/dev/null) || return 2; printf '%s\\n' "$t" | awk -v g="$1" '$2==g && $3 !~ /^Z/ {print $1}'; }
group() { m=$(members "$1") || return 0; [ -n "$m" ]; }`;

/** job.stop's remote script: exit 0 only on proof (see the header). */
function stopScript(handle) {
  return `${READ_STATE.replace("%H", handle)}; RECEIPT=${q(receiptOf(handle))}
mkdir -p "$D" || exit 5
if mkdir "$D/$H" 2>/dev/null; then echo stopped > "$D/$H/stopped"; echo "$RECEIPT never-started"; exit 0; fi
[ -f "$D/$H/stopped" ] && { echo "already stopped"; echo "$RECEIPT already-stopped"; exit 0; }
n=0; while [ ! -f "$D/$H/pid" ] && [ $n -lt 5 ]; do sleep 1; n=$((n+1)); done
[ -f "$D/$H/pid" ] || { echo "claimed but no pid recorded" >&2; exit 3; }
read -r P L < "$D/$H/pid"
mine=0; leader "$P" "$L" && mine=1
gone() { ! leader "$P" "$L" && ! group "$P"; }
if [ $mine = 1 ]; then
  for s in HUP TERM KILL; do
    gone && break
    m=$(members "$P") || { echo "ps failed" >&2; exit 6; }
    kill -$s $P $m 2>/dev/null
    n=0; while ! gone && [ $n -lt 3 ]; do sleep 1; n=$((n+1)); done
  done
fi
gone || { echo "process $P or its group still runs" >&2; exit 4; }
echo stopped > "$D/$H/stopped"; echo "$RECEIPT gone"`;
}

/** job.status's remote script: one line, `running`, `ended` or `unknown <why>`. */
function statusScript(handle) {
  return `${READ_STATE.replace("%H", handle)}
[ -d "$D/$H" ] || { echo "unknown not started on the host yet"; exit 0; }
[ -f "$D/$H/stopped" ] && { echo ended; exit 0; }
[ -f "$D/$H/pid" ] || { echo "unknown starting"; exit 0; }
read -r P L < "$D/$H/pid"
if leader "$P" "$L"; then echo running
elif group "$P"; then echo "unknown leader gone, its group remains"
else echo ended; fi`;
}

/** The handle a job call is about: the recorded one if well-formed, else derived from the key. */
function handleFor(params) {
  const given = params.target?.job?.handle;
  if (typeof given === "string") return HANDLE.test(given) ? given : null;
  return typeof params.key === "string" ? handleOf(params.key) : null;
}

function jobStart(id, params) {
  const host = params.target?.host?.name;
  const spec = params.spec ?? {};
  const bad = (why) => fail(id, "permanent", `mu-plugin-ssh: ${why}`);
  if (typeof host !== "string" || typeof spec.cmd !== "string" || typeof spec.cwd !== "string") {
    bad("job.start needs a host, cmd and cwd");
    return;
  }
  const env = spec.env ?? {};
  for (const k of Object.keys(env)) {
    if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(k)) {
      bad(`environment name ${JSON.stringify(k)} is not a shell identifier`);
      return;
    }
  }
  const forward = [];
  if (spec.sockets) {
    const { local, remote } = spec.sockets;
    // ssh splits -L on ':' with no escape.
    if (/:/.test(local) || /:/.test(remote)) {
      bad("a ctl socket path with ':' cannot be an ssh -L forward");
      return;
    }
    forward.push("-L", `${local}:${remote}`);
  }
  const handle = handleOf(params.key);
  const remote = `exec /bin/sh -c ${q(launchScript(handle, spec.cwd, env, spec.cmd))}`;
  const argv = [
    SSH[0],
    // Ours come first: ssh keeps the first value of an option.
    "-o", "ControlMaster=no",
    "-o", "ControlPath=none",
    "-o", "StreamLocalBindUnlink=yes",
    "-o", "ExitOnForwardFailure=yes",
    ...forward,
    ...SSH.slice(1),
    host,
    "-t",
    remote,
  ];
  reply(id, { view: { command: argv.map(q).join(" "), env: {} }, handle });
}

/** Run `script` on the host over its own ssh connection and hand its result on. */
function remote(id, params, script, then) {
  const host = params.target?.host?.name;
  const left = typeof params.deadline === "number" ? params.deadline - Date.now() : 30_000;
  const timeoutMs = Math.min(Math.max(left - 500, 5_000), 120_000);
  run(id, [...SSH, host, `exec /bin/sh -c ${q(script)}`], { timeoutMs, host, then });
}

function jobStop(id, params) {
  const handle = handleFor(params);
  if (handle === null) {
    fail(id, "permanent", "mu-plugin-ssh: malformed job handle");
    return;
  }
  remote(id, params, stopScript(handle), (r) => {
    // Proof is the script's exit 0 and its receipt for this handle: a login shell, a forced
    // command or a wrapper can exit 0 without running it. Anything else leaves the job as it is.
    const receipt = new RegExp(`^${receiptOf(handle)} (never-started|already-stopped|gone)$`, "m");
    if (r.exitCode === 0 && receipt.test(r.stdout)) reply(id, null);
    else {
      const why = r.exitCode === null ? "timed out" : r.exitCode === 0 ? "no receipt" : `exit ${r.exitCode}`;
      fail(
        id,
        "retryable",
        `no proof the ssh job is gone (${why}): ${r.stderr.trim().split("\n")[0] || "no output"}`,
        "check the host, then close again",
      );
    }
  });
}

function jobStatus(id, params) {
  const handle = handleFor(params);
  if (handle === null) {
    fail(id, "permanent", "mu-plugin-ssh: malformed job handle");
    return;
  }
  remote(id, params, statusScript(handle), (r) => {
    const line = r.stdout.trim().split("\n")[0] ?? "";
    if (r.exitCode === 0 && line === "running") reply(id, { state: "running" });
    else if (r.exitCode === 0 && line === "ended") reply(id, { state: "ended", exit: null });
    else {
      const why = r.exitCode === 0 ? line.replace(/^unknown /, "") : `ssh ${r.exitCode ?? "timed out"}`;
      reply(id, { state: "unknown", reason: why || "no answer" });
    }
  });
}

function answer(id, method, params) {
  const host = params?.target?.host?.name;
  switch (method) {
    case "link.exec":
      exec(id, host, params.script, params.cwd, params.timeoutMs);
      return;
    case "link.fetch": {
      // Run git here; it reaches the host over the same ssh command.
      const env =
        SSH.length === 1 && SSH[0] === "ssh"
          ? process.env
          : { ...process.env, GIT_SSH_COMMAND: SSH.map(q).join(" ") };
      run(id, ["git", "fetch", "--quiet", `${host}:${params.remoteCwd}`, "HEAD"], {
        timeoutMs: params.timeoutMs,
        env,
        cwd: params.localRepo,
        host,
      });
      return;
    }
    case "link.checkSteps": {
      if (params.phase !== "reach") {
        reply(id, []);
        return;
      }
      const t0 = Date.now();
      const child = spawn(SSH[0], [...SSH.slice(1), host, "true"], {
        stdio: ["ignore", "ignore", "pipe"],
      });
      let stderr = "";
      child.stderr.on("data", (d) => {
        stderr += d;
      });
      const timer = setTimeout(() => child.kill("SIGKILL"), 8000);
      const step = (ok, detail) => {
        clearTimeout(timer);
        reply(id, [{ step: "reachable", ok, detail }]);
      };
      child.on("error", (e) => step(false, e.message));
      child.on("close", (code) =>
        code === 0
          ? step(true, `ssh ${host}: ${Date.now() - t0} ms`)
          : step(false, stderr.trim().split("\n")[0] || `ssh ${host} exited ${code}`),
      );
      return;
    }
    case "job.start":
      jobStart(id, params);
      return;
    case "job.lookup":
      // job.start has no remote effect, so nothing is ever found: a none is true.
      reply(id, { none: true });
      return;
    case "job.status":
      jobStatus(id, params);
      return;
    case "job.stop":
      jobStop(id, params);
      return;
    case "shutdown":
      reply(id, null);
      return;
    default:
      fail(id, "permanent", `mu-plugin-ssh has no method ${method}`);
  }
}

function onMessage(msg) {
  if (msg.method === "initialize") {
    const offered = msg.params?.protocol ?? { min: 0, max: 0 };
    if (offered.min > 1 || offered.max < 1) {
      fail(msg.id, "permanent", "mu-plugin-ssh speaks protocol 1 only");
      return;
    }
    reply(msg.id, {
      protocol: 1,
      plugin: { name: "ssh", version: "1.0.0" },
      instance: "ssh", // one configuration: the ssh command and your ssh config
      schema: DIGEST,
      seams: SEAMS,
    });
    return;
  }
  if (msg.method === "$/cancel") {
    const child = running.get(msg.params?.id);
    running.delete(msg.params?.id);
    child?.kill("SIGKILL");
    return;
  }
  answer(msg.id, msg.method, msg.params);
}

// One JSON message per line on stdin; replies go to stdout, logs only to stderr.
let buffered = "";
process.stdin.on("data", (chunk) => {
  buffered += chunk;
  for (let nl = buffered.indexOf("\n"); nl !== -1; nl = buffered.indexOf("\n")) {
    const line = buffered.slice(0, nl);
    buffered = buffered.slice(nl + 1);
    if (line.trim() !== "") onMessage(JSON.parse(line));
  }
});
// stdin EOF means mu is done (or died): stop what runs and exit.
process.stdin.on("end", () => {
  for (const child of running.values()) child.kill("SIGKILL");
  process.exit(0);
});
